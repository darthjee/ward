# Backend framework settings
WARD_SECRET_KEY=ward-insecure-dev-only-change-in-production
# Comma-separated retired keys, still accepted for JWT verification during a key rotation
WARD_PREVIOUS_SECRET_KEYS=
WARD_ACCESS_TOKEN_TTL_MS=3600000
WARD_ALLOWED_ORIGINS=http://localhost:3000
WARD_LOG_LEVEL=info
# 'true' holds new self-registrations as pending until an admin approves them
WARD_USER_APPROVAL_REQUIRED=false
NODE_ENV=development
DEBUG=true

# MySQL settings
WARD_MYSQL_HOST=mysql
WARD_MYSQL_PORT=3306
WARD_MYSQL_USER=ward
WARD_MYSQL_PASSWORD=ward
WARD_MYSQL_NAME=ward
# TLS for the MySQL connection — must be 'true' in production (boot fails otherwise)
WARD_MYSQL_SSL=false
# Optional PEM CA, one line with literal \n for newlines (private-CA servers only)
WARD_MYSQL_SSL_CA=
WARD_DEMO_PASSWORD=ward-demo
# Throwaway test database (integration suite only)
WARD_TEST_MYSQL_HOST=mysql_test
WARD_TEST_MYSQL_PORT=3306
WARD_TEST_MYSQL_USER=ward
WARD_TEST_MYSQL_PASSWORD=ward
WARD_TEST_MYSQL_NAME=ward_test

# Email settings
WARD_EMAILS_ENABLED=false
WARD_EMAIL_HOST=localhost
WARD_EMAIL_PORT=587
WARD_EMAIL_USER=
WARD_EMAIL_PASSWORD=
WARD_EMAIL_USE_TLS=true
WARD_EMAIL_FROM=no-reply@ward.local
WARD_EMAIL_TIMEOUT_MS=10000
WARD_EMAIL_METHOD=native

# Frontend settings
FRONTEND_DEV_MODE=true
FRONTEND_BASE_URL=http://localhost:3000

# Cache warmer (Navi)
WARD_PRODUCTION_URL=http://localhost:3000
NAVI_NAMEPACE=default
